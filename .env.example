# Aventus Perfumería — variables de entorno requeridas
# =====================================================
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# --- Supabase (cliente) -------------------------------------------------
# Requeridas: las consume el cliente del navegador para Supabase Auth
# (login, registro, recuperación de contraseña) y — con el backend
# "supabase" — para leer el catálogo y crear pedidos (RPC).
# Los valores NEXT_PUBLIC_ son PÚBLICOS por diseño (viajan al navegador);
# la protección real la aportan RLS. Deben coincidir con los de abajo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=clave-anon-publica
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-anon-publica
# SOLO servidor. Jamás usar desde componentes cliente. La usan los
# endpoints /api/data/*, /api/upload y /api/admin/*.
SUPABASE_SERVICE_ROLE_KEY=clave-service-role

# --- Backend de datos (feature flag) ------------------------------------
# NEXT_PUBLIC_DATA_BACKEND decide la fuente de datos de src/lib/db.ts:
#   localStorage (POR DEFECTO) => modo demo/local: todo en el navegador.
#                                Lo usan los tests E2E (checkout de
#                                invitado, etc.). Dejalo así en local.
#   supabase                   => producción REAL: catálogo remoto,
#                                Supabase Auth, pedidos vía RPC y
#                                /api/admin/orders, imágenes en Storage.
#                                ASÍ SE CONFIGURA EN VERCEL.
# NEXT_PUBLIC_DATA_BACKEND=localStorage
#
# Producción (Vercel → Project Settings → Environment Variables):
#   NEXT_PUBLIC_DATA_BACKEND            = supabase
#   NEXT_PUBLIC_SUPABASE_URL            = https://TU-PROYECTO.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY       = clave-anon-publica
#   SUPABASE_URL                        = https://TU-PROYECTO.supabase.co
#   SUPABASE_ANON_KEY                   = clave-anon-publica
#   SUPABASE_SERVICE_ROLE_KEY           = clave-service-role   (solo servidor)
#   ADMIN_EMAIL / ADMIN_PASSWORD        = acceso al panel /admin
#   ADMIN_SESSION_SECRET                = opcional (firma de la cookie)

# --- Panel de administración (OBLIGATORIO para acceder a /admin) --------
# Se leen únicamente en el servidor (Route Handler /api/auth/admin-login).
# Si no están definidas, el login de admin responde 503 y el panel queda
# inaccesible a propósito (fail closed).
ADMIN_EMAIL=admin@ejemplo.com
# Contraseña fuente: mínimo 8 caracteres. Generá una, no uses "admin123".
ADMIN_PASSWORD=cambia-esta-contrasena-por-una-larga

# --- Sesión del panel ----------------------------------------------------
# Opcional. Si no existe se usa ADMIN_PASSWORD como secreto de firma HMAC
# de la cookie httpOnly de administración.
# ADMIN_SESSION_SECRET=

# --- Mercado Pago (Checkout Pro) --------------------------------------------
# Credenciales de PRUEBA (obtenerlas en https://www.mercadopago.com.ar/developers
# → Tu aplicación → Credenciales de prueba). En producción usar las de
# producción. NUNCA subir las reales al repo.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret
# URL pública del sitio (sin trailing slash). Usada para back_urls y notification_url.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth: configuración del panel (dashboard, no acá) ----------
# 1. Authentication → URL Configuration:
#      Site URL = https://TU-DOMINIO.com  (producción)
#      Redirect URLs += http://localhost:3000/login  y
#                       http://localhost:3000/recuperar-password
#    Sin esto, los enlaces de confirmación/recuperación no redirigen.
# 2. Authentication → Providers → Email:
#      "Confirm email" según prefieras. Si está ON, al registrarse llega
#      un email para activar la cuenta (recomendado en producción; usá
#      SMTP propio: Resend/SendGrid/Postmark, el SMTP integrado de
#      Supabase es de prueba y tiene límite de envíos).
# 3. Storage: el bucket `imagenes` lo crea automáticamente POST /api/upload
#    en el primer uso (público, límite 10 MB). No hay que crearlo a mano.
